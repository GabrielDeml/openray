{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ did not report its environment. Scripts run with the one OpenRay was started with." : {
      "comment" : "Says that the user's shell could not be asked for its environment variables. The placeholder is the shell's name, such as zsh."
    },
    "%@ in · %@ out" : {
      "comment" : "Quick AI: the tokens of a request, under its answer. The placeholders are the numbers of tokens sent and received."
    },
    "%@ in · %@ out · %@ cached" : {
      "comment" : "Quick AI: the tokens of a request, under its answer. The placeholders are the numbers of tokens sent, received, and read from the prompt cache."
    },
    "%@ is hidden. Settings › Commands brings it back." : {
      "comment" : "Shown after an app was hidden from search. The placeholder is the app's name."
    },
    "%@ is not available. Quick AI now uses %@." : {
      "comment" : "Quick AI settings: shown when the chosen model was replaced. Both placeholders are names of models."
    },
    "%@ is not running" : {
      "comment" : "Shown when the Quit action is used on an app that is not running. The placeholder is the app's name."
    },
    "%@ is required" : {
      "comment" : "Shown when Return was pressed without a text for an argument a script needs. The placeholder is what the script calls the argument."
    },
    "%@ works by sending a command to %@, and macOS asks for your permission first." : {
      "comment" : "Explains an Automation permission. The first placeholder is a list of command names, the second an app's name."
    },
    "%lld more" : {
      "comment" : "The end of a list of commands that need a permission, after the first few were named: “Left Half, Right Half, Top Half, and 16 more”.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld more"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld more"
                }
              }
            }
          }
        }
      }
    },
    "(what you copied last)" : {
      "comment" : "Stands in for the clipboard's text in the preview of a snippet that has the placeholder {clipboard}."
    },
    "@openray.%@ has a value that OpenRay cannot use." : {
      "comment" : "Script Diagnostics: the value of a line in the script is not one of those allowed. The placeholder is the line's key, such as “mode” or “timeout”."
    },
    "@openray.%@ is missing." : {
      "comment" : "Script Diagnostics: a line every script needs is not in the file. The placeholder is the line's key, such as “title”; with @openray. in front it is what the user has to type."
    },
    "@openray.%@ is there more than once." : {
      "comment" : "Script Diagnostics: the same line is in the script twice. The placeholder is the line's key, such as “title”."
    },
    "@openray.argument%lld is not valid JSON for an argument." : {
      "comment" : "Script Diagnostics: the description of one of a script's arguments cannot be read. The placeholder is the argument's number, 1 to 3, and is part of the key."
    },
    "@openray.argument%lld is there, but @openray.argument%lld is not." : {
      "comment" : "Script Diagnostics: a script describes its second or third argument and not the one before it. The placeholders are the two arguments' numbers and are part of the keys."
    },
    "@openray.schemaVersion is “%@”. This version of OpenRay reads version 1 only." : {
      "comment" : "Script Diagnostics: the script is written for a format this OpenRay does not know. The placeholder is what the script gives as its version."
    },
    "A key is saved in your Keychain" : {
      "comment" : "Quick AI settings: the state of the API key when one is stored."
    },
    "A snippet can have {cursor} only once." : {
      "comment" : "Shown in the snippet editor while the text has the placeholder {cursor} more than once. {cursor} is typed as it stands."
    },
    "Accessibility" : {
      "comment" : "The name of the Accessibility permission, as in System Settings."
    },
    "Accessibility is no longer allowed. Grant it in Settings › General." : {
      "comment" : "Shown when a window command fails because OpenRay has lost the Accessibility permission."
    },
